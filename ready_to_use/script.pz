# --- BENUTZEREINGABE: Bitte definieren Sie die zeitliche Auflösung Ihres Scans ---
# Dies ist die Zeit in Sekunden zwischen der Aufnahme von zwei 3D-Volumen.
# Diesen Wert müssen Sie aus Ihrem Scan-Protokoll kennen.
time_resolution_seconds = 2.0  # Beispiel: 2 Sekunden pro Zeitaufnahme
num_time_points = 250          # Aus Ihrer reshape-Logik bekannt

# 1. Erstellen Sie den Zeitvektor (`tacq`)
tacq = np.arange(0, num_time_points * time_resolution_seconds, time_resolution_seconds)

# 2. Generieren Sie den Parker AIF auf diesem Zeitvektor
# HINWEIS: Dies erzeugt eine KONZENTRATIONS-Kurve, keine Signal-Kurve.
aif = dcmri.aif_parker(tacq)

print("Populations-AIF (Parker) erfolgreich generiert.")
print(f"Form des AIF-Arrays: {aif.shape}")
print(f"Form des Zeit-Arrays: {tacq.shape}")

# 3. Visuelle Überprüfung des generierten AIF
plt.figure(figsize=(10, 5))
plt.plot(tacq, aif, marker='.', linestyle='-')
plt.title('Generierter Populations-AIF (Parker)')
plt.xlabel('Zeit (Sekunden)')
plt.ylabel('Kontrastmittel-Konzentration (mM)')
plt.grid(True)
plt.show()

# Konvertieren in Listen für die mdreg-Funktion
